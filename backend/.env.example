NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers)
# Also add your IP in Atlas → Network Access (or 0.0.0.0/0 for dev)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<app>
# Windows dev only: set true if you see "unable to verify the first certificate" (antivirus HTTPS scanning)
MONGODB_TLS_ALLOW_INVALID_CERTS=false
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=fxdc_token
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
ADMIN_EMAIL=admin@fxdc.local
ADMIN_PASSWORD=ChangeMeNow!123
SUPER_ADMIN_EMAIL=superadmin@fxdc.local
SUPER_ADMIN_PASSWORD=Password@555
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fxdc-camp

# CipherBC crypto payments (https://docs.cipherbc.com/payment/)
# Use separate keys for test vs production — never mix environments.
CIPHERBC_API_BASE_URL=https://api-test.example.com/shopapi
CIPHERBC_APP_ID=your_app_id
CIPHERBC_MERCHANT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
CIPHERBC_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
CIPHERBC_CALLBACK_URL=https://your-backend.example.com/api/payments/webhook/cipherbc
CIPHERBC_WEBSITE_URL=http://localhost:5173
CIPHERBC_KEY_VERSION=admin
# Optional: comma-separated IPs allowed to call the webhook (recommended in production)
CIPHERBC_WEBHOOK_IP_ALLOWLIST=
